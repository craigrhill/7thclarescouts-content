{
  "name": "7thclarescouts-content",
  "private": true,
  "description": "7th Clare Scouts app. Static site plus one Netlify Function; see CLAUDE.md.",
  "scripts": {
    "build:function": "esbuild netlify/src/content.mjs --bundle --platform=node --format=esm --outfile=netlify/functions/content.mjs --log-level=warning",
    "test:function": "node tools/test-function.mjs netlify/functions/content.mjs",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "@netlify/blobs": "11.0.3",
    "esbuild": "^0.28.2"
  }
}
